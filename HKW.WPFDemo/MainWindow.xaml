<Window
  x:Class="HKW.WPFDemo.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:HKW.WPFDemo"
  xmlns:h="https://hkw.com/wpf/helpers"
  mc:Ignorable="d"
  Title="MainWindow"
  Height="450"
  Width="800"
>
  <Grid ColumnDefinitions="*,*">
    <ListBox SelectedIndex="0" x:Name="ListBox">
      <ListBoxItem Content="1" />
      <ListBoxItem Content="2" />
      <ListBoxItem Content="3" />
    </ListBox>
    <StackPanel
      h:PanelHelper.ShowChildByIndex="{Binding SelectedIndex,ElementName=ListBox}"
      Grid.Column="1"
    >
      <TextBlock Text="111" />
      <TextBlock Text="222" />
      <TextBlock Text="333" />
    </StackPanel>
  </Grid>
</Window>
